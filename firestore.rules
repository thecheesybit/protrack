rules_version = '2';

// PRO TRACK — every document lives under users/{uid}. A user can only ever
// read or write their own subtree. Nothing is world-readable.
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow read, write: if isOwner(userId);

      // All nested collections (modes, subjects, tasks, focusSessions,
      // habits, todos, notes, …) inherit the same owner-only rule.
      match /{document=**} {
        allow read, write: if isOwner(userId);
      }
    }

    // Desktop QR auth handshake. The sessionId is an unguessable bearer secret.
    // The desktop (anonymous auth) creates + reads + deletes its own handshake.
    // The custom token is written ONLY by the Cloud Function (Admin SDK), which
    // bypasses these rules — so clients can never write the token field.
    match /desktopHandshakes/{sessionId} {
      allow create: if request.auth != null
        && request.resource.data.desktopUid == request.auth.uid
        && request.resource.data.status == 'pending'
        && !('token' in request.resource.data);
      allow get: if request.auth != null
        && resource.data.desktopUid == request.auth.uid;
      allow delete: if request.auth != null
        && resource.data.desktopUid == request.auth.uid;
    }
  }
}
