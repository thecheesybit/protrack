rules_version = '2';

// PRO TRACK — every document lives under users/{uid}. A user can only ever
// read or write their own subtree. Nothing is world-readable.
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // The single administrator — Google-verified email only.
    function isAdmin() {
      return isSignedIn()
        && request.auth.token.email == 'ak818ace@gmail.com'
        && request.auth.token.email_verified == true;
    }

    match /users/{userId} {
      allow read, write: if isOwner(userId);

      // All nested collections (modes, subjects, tasks, focusSessions,
      // habits, todos, notes, …) inherit the same owner-only rule.
      match /{document=**} {
        allow read, write: if isOwner(userId);
      }
    }

    // Desktop QR auth handshake. The sessionId is an unguessable bearer secret.
    // The desktop (anonymous auth) creates + reads + deletes its own handshake.
    // The custom token is written ONLY by the Cloud Function (Admin SDK), which
    // bypasses these rules — so clients can never write the token field.
    match /desktopHandshakes/{sessionId} {
      allow create: if request.auth != null
        && request.resource.data.desktopUid == request.auth.uid
        && request.resource.data.status == 'pending'
        && !('token' in request.resource.data);
      allow get: if request.auth != null
        && resource.data.desktopUid == request.auth.uid;
      allow update: if request.auth != null
        && resource.data.status == 'pending'
        && request.resource.data.status == 'claimed'
        && request.resource.data.desktopUid == resource.data.desktopUid
        && 'token' in request.resource.data;
      allow delete: if request.auth != null
        && resource.data.desktopUid == request.auth.uid;
    }

    // Support Corner — contribution intake. A signed-in user may CREATE their
    // own owner-stamped pending packet, but can never read/list/modify the
    // queue. Only the admin reads, verifies, and clears it.
    match /pending_contributions/{id} {
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.amount is number
        && request.resource.data.amount > 0
        && !('verifiedAt' in request.resource.data);
      allow read, update, delete: if isAdmin();
    }

    // Wall of Honor — world-readable (the public contributor wall); only the
    // admin promotes records here. Display-safe fields only (no email/uid PII).
    match /verified_patreons/{uid} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }
  }
}
