rules_version = '2';

// Antigravity — every document lives under users/{uid}. A user can only ever
// read or write their own subtree. Nothing is world-readable.
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow read, write: if isOwner(userId);

      // All nested collections (modes, subjects, tasks, focusSessions,
      // habits, todos, notes, …) inherit the same owner-only rule.
      match /{document=**} {
        allow read, write: if isOwner(userId);
      }
    }
  }
}
