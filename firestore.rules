rules_version = '2';

// PRO TRACK — every document lives under users/{uid}. A user can only ever
// read or write their own subtree. Nothing is world-readable.
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // The single administrator — Google-verified email only.
    function isAdmin() {
      return isSignedIn()
        && request.auth.token.email == 'ak818ace@gmail.com'
        && request.auth.token.email_verified == true;
    }

    match /users/{userId} {
      allow read, write: if isOwner(userId);

      // All nested collections (modes, subjects, tasks, focusSessions,
      // habits, todos, notes, …) inherit the same owner-only rule.
      match /{document=**} {
        allow read, write: if isOwner(userId);
      }
    }

    // Desktop QR auth handshake. The sessionId is an unguessable bearer secret.
    // The desktop (anonymous auth) creates + reads + deletes its own handshake.
    // The custom token is written ONLY by the Cloud Function (Admin SDK), which
    // bypasses these rules — so clients can never write the token field.
    match /desktopHandshakes/{sessionId} {
      allow create: if request.auth != null
        && request.resource.data.desktopUid == request.auth.uid
        && request.resource.data.status == 'pending'
        && !('token' in request.resource.data);
      allow get: if request.auth != null
        && resource.data.desktopUid == request.auth.uid;
      allow update: if request.auth != null
        && resource.data.status == 'pending'
        && request.resource.data.status == 'claimed'
        && request.resource.data.desktopUid == resource.data.desktopUid
        && 'token' in request.resource.data;
      allow delete: if request.auth != null
        && resource.data.desktopUid == request.auth.uid;
    }

    // Tablet companion handshake.
    // The tablet boots an ephemeral pending doc (sessionId = unguessable Crockford base32).
    // The browser claims it with a Google ID token; the waiting tablet authenticates
    // via credential listener and immediately deletes the doc.
    match /companionHandshakes/{sessionId} {
      allow create: if isSignedIn()
        && ((request.resource.data.tabletUid == request.auth.uid
             && request.resource.data.status == 'pending'
             && !('token' in request.resource.data))
            || (request.resource.data.creatorUid == request.auth.uid
                && request.resource.data.status == 'available'
                && 'token' in request.resource.data));
      allow get: if isSignedIn();
      allow update: if isSignedIn()
        && resource.data.status == 'pending'
        && request.resource.data.status == 'claimed'
        && request.resource.data.tabletUid == resource.data.tabletUid
        && 'token' in request.resource.data;
      allow delete: if isSignedIn();
    }

    // Support Corner — contribution intake. A signed-in user may CREATE their
    // own owner-stamped pending packet, but can never read/list/modify the
    // queue. Only the admin reads, verifies, and clears it.
    match /pending_contributions/{id} {
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.amount is number
        && request.resource.data.amount > 0
        && !('verifiedAt' in request.resource.data);
      allow read, update, delete: if isAdmin();
    }

    // Wall of Honor — world-readable (the public contributor wall); only the
    // admin promotes records here. Display-safe fields only (no email/uid PII).
    match /verified_patreons/{uid} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Public focus leaderboard — world-readable so any signed-in user can see
    // the ranked board and other users' forest snapshots. Each user writes ONLY
    // their own display-safe aggregate (name, focus minutes, plant counts,
    // streak, compact forest). No private data (subjects/todos/scores) is ever
    // published here. Same trust model as the Wall of Honor, but owner-written.
    match /leaderboard/{userId} {
      allow read: if true;
      allow create, update, delete: if isOwner(userId);
    }
  }
}
