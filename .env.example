# ─────────────────────────────────────────────────────────────
# Firebase Web App config
# Copy this file to `.env` (or `.env.local`) and fill in your values.
# Firebase Console → Project Settings → General → Your apps → SDK setup.
# All client env vars MUST be prefixed with VITE_ to be exposed by Vite.
# ─────────────────────────────────────────────────────────────
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ─────────────────────────────────────────────────────────────
# Google OAuth Web client ID — enables Google Identity Services
# silent token refresh for the two-way Google Calendar sync, so the
# connection persists without hourly reconnect prompts.
# Cloud Console → APIs & Services → Credentials →
#   "Web client (auto created by Google Service)".
# Optional: leave blank to fall back to the Firebase popup token
# (works, but lapses ~hourly).
# ─────────────────────────────────────────────────────────────
VITE_GOOGLE_OAUTH_CLIENT_ID=
