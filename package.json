{
  "name": "pro-track",
  "private": true,
  "version": "2.13.2",
  "type": "module",
  "description": "PRO TRACK — a radically simplified, auto-adapting all-in-one productivity workspace.",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --host",
    "electron:dev": "cross-env ELECTRON=true vite",
    "electron:build": "cross-env ELECTRON=true vite build && electron-builder",
    "electron:build:win": "cross-env ELECTRON=true vite build && electron-builder --win",
    "electron:build:appx": "cross-env ELECTRON=true vite build && electron-builder --win appx",
    "electron:build:mac": "cross-env ELECTRON=true vite build && electron-builder --mac",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src",
    "analyze": "cross-env ANALYZE=true vite build",
    "size": "size-limit",
    "knip": "knip",
    "check:videos": "node scripts/check-video-audio.mjs",
    "optimize:assets": "node scripts/optimize-assets.mjs",
    "cap:sync": "cross-env CAPACITOR=true vite build && cap sync android",
    "cap:copy": "cross-env CAPACITOR=true vite build && cap copy android",
    "cap:open": "cap open android",
    "cap:build": "cross-env CAPACITOR=true vite build && cap sync android"
  },
  "dependencies": {
    "@capacitor-firebase/authentication": "^6.3.1",
    "@capacitor/android": "^6.2.0",
    "@capacitor/app": "^6.0.2",
    "@capacitor/core": "^6.2.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@google/generative-ai": "^0.21.0",
    "chrono-node": "^2.9.1",
    "clsx": "^2.1.1",
    "date-fns": "^3.6.0",
    "electron-updater": "^6.8.9",
    "firebase": "^10.13.2",
    "framer-motion": "^11.5.4",
    "html-to-image": "^1.11.13",
    "lucide-react": "^0.445.0",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hot-toast": "^2.4.1",
    "recharts": "^2.15.4",
    "tailwind-merge": "^2.5.2",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@capacitor/cli": "^6.2.0",
    "@eslint/js": "^10.0.1",
    "@size-limit/file": "^13.1.1",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitest/coverage-v8": "^2.1.9",
    "autoprefixer": "^10.4.20",
    "cross-env": "^7.0.3",
    "electron": "^31.7.7",
    "electron-builder": "^25.1.8",
    "eslint": "^10.4.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "globals": "^17.6.0",
    "knip": "^6.36.0",
    "postcss": "^8.4.47",
    "rollup-plugin-visualizer": "^7.1.1",
    "sharp": "^0.35.4",
    "size-limit": "^13.1.1",
    "tailwindcss": "^3.4.13",
    "vite": "^5.4.8",
    "vite-plugin-electron": "^0.28.8",
    "vitest": "^2.1.9"
  }
}
